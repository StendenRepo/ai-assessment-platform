# Root .env for Docker Compose variable substitution.
# Copy this file to .env and fill in the values.

#Dev Settings
RUN_MIGRATIONS=true

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_assessment

# Backend
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_assessment
UPLOAD_DIR=/app/data/uploads
RECORDING_DIR=/app/data/recordings
EXPORT_DIR=/app/data/exports

# Auth
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:3000
EVIDENCE_PATH_SALT=change-me-evidence-path-salt

# Ollama — general stack (fast models; image evidence, notifications, etc.)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_MODEL_BACKUP=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=20

# Ollama — assessment review + overlap LLM paths (structured JSON, longer context)
ASSESSMENT_OLLAMA_MODEL=qwen2.5:7b
ASSESSMENT_OLLAMA_MODEL_BACKUP=llama3.1:8b
ASSESSMENT_OLLAMA_TIMEOUT_SECONDS=120

# Set to 1 to enable the NVIDIA GPU compose override; leave blank for CPU-only.
USE_GPU=1
COMPOSE_FILE=docker-compose.dev.yml${USE_GPU:+;docker-compose.gpu.yml}

# Vision model for image evidence description (pulled separately — requires ~4.7 GB)
VISION_MODEL=llava:7b
VISION_TIMEOUT_SECONDS=60

# Ollama container resource limits (Docker Compose deploy.resources)
# Increase these to speed up vision/image processing.
OLLAMA_CPU_LIMIT=4.0
OLLAMA_MEMORY_LIMIT=4G
OLLAMA_CPU_RESERVATION=1.0
OLLAMA_MEMORY_RESERVATION=1G

# AI-text classifier (RoBERTa in ai-detector container)
AI_DETECTOR_URL=http://ai-detector:9001
AI_DETECTOR_MODEL=Hello-SimpleAI/chatgpt-detector-roberta
AI_DETECTOR_TIMEOUT_SECONDS=120

# Overlap detection tuning (advanced) - scoring thresholds on a 0-1 scale.
# Leave unset to use the validated defaults shown below. *_FLAG_MIN keeps one
# flagged passage; *_DOCUMENT_MIN reports the document at all; *_CONFIRMED_MIN
# is the high-trust "confirmed" bar shown to teachers.
# AI-generated-text detection:
OVERLAP_AI_FLAG_MIN=0.62
OVERLAP_AI_DOCUMENT_MIN=0.58
OVERLAP_AI_CONFIRMED_MIN=0.76
OVERLAP_AI_HEURISTIC_MIN=0.70
OVERLAP_AI_CLASSIFIER_MIN=0.15
OVERLAP_AI_CLASSIFIER_CONFIRMED=0.50
OVERLAP_AI_CLASSIFIER_SEGMENT_MIN=0.55
# Student-to-student plagiarism detection:
OVERLAP_STUDENT_POSSIBLE_MIN=0.42
OVERLAP_STUDENT_CONFIRMED_MIN=0.68
OVERLAP_STUDENT_AI_FLAG_MIN=0.72
OVERLAP_STUDENT_AI_CONFIRMED_MIN=0.82
# No-LLM near-duplicate fast path:
OVERLAP_NEAR_DUPLICATE_DOC_MIN=0.90
OVERLAP_NEAR_DUPLICATE_UNIT_MIN=0.82
# TF-IDF statistical prescreen:
OVERLAP_TFIDF_CONFIRMED_MIN=0.68
OVERLAP_TFIDF_POSSIBLE_MIN=0.50

# Seed admin account (used by the initial migration)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=changeme
