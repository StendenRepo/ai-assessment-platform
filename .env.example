# Root .env for Docker Compose variable substitution.
# Copy this file to .env and fill in the values.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_assessment

# Backend
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_assessment
UPLOAD_DIR=/app/data/uploads
RECORDING_DIR=/app/data/recordings
EXPORT_DIR=/app/data/exports

# Auth
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:3000

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_MODEL_BACKUP=qwen2.5:3b

# Backend container resource limits (Docker Compose deploy.resources)
# Increase BACKEND_CPU_LIMIT to give the OCR process more CPU threads.
# Increase BACKEND_MEMORY_LIMIT if large images cause OOM kills.
BACKEND_CPU_LIMIT=4.0
BACKEND_MEMORY_LIMIT=4G
BACKEND_CPU_RESERVATION=0.5
BACKEND_MEMORY_RESERVATION=512M

# OCR tuning for image evidence extraction
# Set OCR_FAST_MODE=false for higher accuracy at the cost of slower extraction
OCR_FAST_MODE=true
OCR_MIN_ACCEPT_SCORE=12 # min characters before accepting OCR result
OCR_EARLY_EXIT_SCORE=80 # stop trying more variants once this score is reached

# Seed admin account (used by the initial migration)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=changeme