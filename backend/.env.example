# Backend environment variables
APP_ENV=development
PORT=8000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_assessment
# Data dirs. These are the absolute container paths (mounted on the app_data
# volume) the rest of the stack expects. Relative paths are still resolved
# against backend/ at runtime, so local dev works off the config.py defaults.
UPLOAD_DIR=/app/data/uploads
RECORDING_DIR=/app/data/recordings
EXPORT_DIR=/app/data/exports

# Speech-to-text (on-premise faster-whisper container)
STT_URL=http://stt:9000
STT_TIMEOUT_SECONDS=600

# Recording retention (GDPR): flag for deletion after N days, remind N days before
RECORDING_RETENTION_DAYS=90
RECORDING_REMINDER_LEAD_DAYS=14

# Auth
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:3000

# Seed admin account (used by the initial migration)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=changeme