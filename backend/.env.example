# Backend environment variables
APP_ENV=development
PORT=8000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_assessment
# Data dirs are relative to the backend/ directory and resolved to absolute
# paths at runtime. This works both locally (-> backend/data/...) and in Docker
# (-> /app/data/... on the app_data volume). Override with an absolute path if needed.
UPLOAD_DIR=./data/uploads
RECORDING_DIR=./data/recordings
EXPORT_DIR=./data/exports

# Speech-to-text (on-premise faster-whisper container)
STT_URL=http://stt:9000
STT_TIMEOUT_SECONDS=600

# Recording retention (GDPR): flag for deletion after N days, remind N days before
RECORDING_RETENTION_DAYS=90
RECORDING_REMINDER_LEAD_DAYS=14

# Auth
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:3000

# Seed admin account (used by the initial migration)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=changeme